module load conda/miniforge3/24.11.3-0

conda create -n BST_Final_Proj_01 python=3.10 -y
conda activate BST_Final_Proj_01

conda install -c bioconda bowtie2 samtools bcftools sra-tools -y
conda install -c bioconda ncbi-datasets-cli -y

mkdir BST_Final_Proj
cd BST_Final_Proj

datasets download genome accession GCF_018292205.1 --include genome
unzip ncbi_dataset.zip
find ncbi_dataset/ -name "*.fna"
bowtie2-build ncbi_dataset/data/GCF_018292205.1/GCF_018292205.1_ASM1829220v1_genomic.fna ref_index


prefetch ERR13818447
fasterq-dump ERR13818447/ERR13818447.sra --split-files -O .

bowtie2 -x ref_index -1 ERR13818447_1.fastq -2 ERR13818447_2.fastq -S ERR13818447.sam

